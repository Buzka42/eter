<?xml version="1.0" encoding="utf-8"?>
<!-- Eter is local-first; the only permitted network traffic is TLS to the
     configured Firebase/Google backends. Cleartext is denied everywhere. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
